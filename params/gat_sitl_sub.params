# Parameters to test transect.lua in SITL (sans Gazebo), for ArduSub version 4.7

# Shells:
# ../Tools/autotest/sim_vehicle.py -L RATBeach -v ArduSub -f vectored --out=udp:0.0.0.0:14550 --out=udp:0.0.0.0:14551 --wipe --add-param-file=$HOME/projects/guided_above_terrain/params/gat_sitl_sub.params
# ./QGroundControl.AppImage

# Scripts (choose one of the gat_pva_sub scripts):
# mkdir scripts; cd scripts
# ln -s $HOME/projects/guided_above_terrain/lua/get_rangefinder.lua get_rangefinder.lua
# ln -s $HOME/projects/guided_above_terrain/lua/gat_pva_sub.lua gat_pva_sub.lua
# ln -s $HOME/ap/gat_pva/libraries/AP_Scripting/examples/gat_pva_sub.lua gat_pva_sub.lua

SCR_ENABLE 1

BTN0_FUNCTION       1.0         # shift
BTN11_SFUNCTION     108         # shift-dpad-up      script_1: increment rf_target by 10 cm
BTN12_SFUNCTION     109         # shift-dpad-down    script_2: decrement rf_target by 10 cm
BTN13_SFUNCTION     111         # shift-dpad-right   script_4: increment speed by 10 cm/s
BTN14_SFUNCTION     110         # shift-dpad-left    script_3: decrement speed by 10 cm/s
BTN2_SFUNCTION      11          # shift-X            GUIDED mode
BTN3_SFUNCTION      13          # shift-Y            SURFTRAK mode

# Reduce baro noise
SIM_BARO_RND 0.02

# Set reasonable GUIDED mode speeds
WP_SPD_DN 0.3
WP_SPD_UP 0.3
WP_SPD 0.2

# Expand default SITL rangefinder to work over the entire water column
RNGFND1_MIN 0.2
RNGFND1_MAX 50.0
