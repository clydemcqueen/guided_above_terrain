# Parameters to test transect.lua in SITL (sans Gazebo), for ArduSub version 4.7

# Shells:
# ../Tools/autotest/sim_vehicle.py -L RATBeach -v ArduSub -f vectored --out=udp:0.0.0.0:14550 --out=udp:0.0.0.0:14551 --wipe --add-param-file=$HOME/host_ws/guided_above_terrain/params/transect_sitl.params
# ./QGroundControl.AppImage

# Setting up scripts:
# mkdir scripts; cd scripts
# ln -s $HOME/host_ws/guided_above_terrain/lua/get_rangefinder.lua get_rangefinder.lua
# ln -s $HOME/host_ws/guided_above_terrain/lua/transect4.lua transect4.lua

SCR_ENABLE          1

# RNGFND1 is an analog rangefinder, adjust the min and max
RNGFND1_MAX         50.0
RNGFND1_MIN         0.2

# Controller button assignments for QGC
# For Cockpit: upload dbl-mapping.json
BTN0_FUNCTION    1    # A                   shift
BTN0_SFUNCTION   1    # shift A             shift
BTN1_FUNCTION    5    # B                   MANUAL
BTN1_SFUNCTION   8    # shift B             POSHOLD
BTN2_FUNCTION    7    # X                   ALT_HOLD
BTN2_SFUNCTION   13   # shift X             SURFTRAK
BTN3_FUNCTION    6    # Y                   STABILIZE
BTN3_SFUNCTION   11   # shift Y             GUIDED

BTN11_SFUNCTION  109  # shift-dpad-up       script_2
BTN12_SFUNCTION  110  # shift-dpad-down     script_3
BTN13_SFUNCTION  111  # shift-dpad-left     script_4
BTN14_SFUNCTION  108  # shift-dpad-right    script_1

# Reduce baro noise
SIM_BARO_RND        0.02

# WP_SPD sets the max xy speed ceiling that will be allowed in GUIDED PVA mode
WP_SPD              1.0

# Typical Lutris and Nereo parameters
PILOT_SPEED_UP      50          # SURFTRAK uses PILOT_ parameters in cm
PILOT_SPEED_DN      50
PILOT_ACCEL_Z       500
WP_SPD_UP           0.5         # GUIDED uses WP_ parameters in m
WP_SPD_DN           0.5
WP_ACC_Z            5.0
PSC_D_JERK          8.0         # Both modes use PSC_ parameters in m
