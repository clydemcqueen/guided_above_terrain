# Parameters to test gat_pva_sub.lua in Gazebo

# Setup is mostly described in bluerov2_gz README. My super-terse notes:
# Use colcon to build {ardupilot_gazebo, ros2}, {bluerov2_gz, ping_sonar}; set up env vars
# cd scripts; ln -s ~/projects/guided_above_terrain/lua/gat_pva_sub.lua gat_pva_sub.lua

# Shells:
# gz sim -v 3 -r bluerov2_ping.world
# ../Tools/autotest/sim_vehicle.py -L RATBeach -v ArduSub -f vectored --model=JSON --out=udp:0.0.0.0:14550 --wipe --add-param-file=$HOME/projects/guided_above_terrain/params/gat_gz_sub.params
# ./QGroundControl.AppImage

SCR_ENABLE 1

RNGFND1_TYPE        100
RNGFND1_FUNCTION    0
RNGFND1_MAX         50
RNGFND1_MIN         0.5
RNGFND1_ORIENT      25

BTN0_FUNCTION       1.0         # shift
BTN11_SFUNCTION     108         # shift-dpad-up      script_1: increment rf_target by 10 cm
BTN12_SFUNCTION     109         # shift-dpad-down    script_2: decrement rf_target by 10 cm
BTN13_SFUNCTION     111         # shift-dpad-right   script_4: increment speed by 10 cm/s
BTN14_SFUNCTION     110         # shift-dpad-left    script_3: decrement speed by 10 cm/s
BTN2_SFUNCTION      11          # shift-X            GUIDED mode
BTN3_SFUNCTION      13          # shift-Y            SURFTRAK mode

# Reduce baro noise
SIM_BARO_RND 0.02

# WP_SPD sets the max xy speed that will be allowed in GUIDED PVA mode, leave it at the default
# WP_SPD 1.0

# Set the forward speed
SCR_USER1 0.5
