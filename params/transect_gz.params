# Parameters to test transect.lua in Gazebo, for ArduPilot 4.7

# Setup is mostly described in bluerov2_gz README. 
# Use colcon to build {ardupilot_gazebo, ros2}, {bluerov2_gz, main}; set up env vars, cp transect.lua to scripts dir
# ArduPilot-4.7 has a bug that affects Gazebo. There is a fix on master: https://github.com/ArduPilot/ardupilot/pull/33342 

# Shells:
# gz sim -v 3 -r bluerov2_ping.world
# ../Tools/autotest/sim_vehicle.py -L RATBeach -v ArduSub -f vectored --model=JSON --out=udp:0.0.0.0:14550 --wipe --add-param-file=$HOME/host_ws/guided_above_terrain/params/transect_gz.params
# ./QGroundControl.AppImage

# Setting up scripts:
# mkdir scripts; cd scripts
# ln -s $HOME/host_ws/guided_above_terrain/lua/get_rangefinder.lua get_rangefinder.lua
# ln -s $HOME/host_ws/guided_above_terrain/lua/transect.lua transect.lua

SCR_ENABLE          1

# Set up Gazebo (JSON) rangefinder, adjust the min and max
RNGFND1_TYPE        100
RNGFND1_FUNCTION    0
RNGFND1_MAX         50.0
RNGFND1_MIN         0.2

BTN0_FUNCTION       1.0         # shift
BTN2_SFUNCTION      11          # shift-X            GUIDED mode
BTN3_SFUNCTION      13          # shift-Y            SURFTRAK mode
BTN11_SFUNCTION     108         # shift-dpad-up      script_1: increment rf_target by 10 cm
BTN12_SFUNCTION     109         # shift-dpad-down    script_2: decrement rf_target by 10 cm
BTN13_SFUNCTION     110         # shift-dpad-left    script_3: decrement speed by 5 cm/s
BTN14_SFUNCTION     111         # shift-dpad-right   script_4: increment speed by 5 cm/s

# Reduce baro noise
SIM_BARO_RND        0.02

# WP_SPD sets the max xy speed ceiling that will be allowed in GUIDED PVA mode
WP_SPD              1.0

# Typical Lutris and Nereo parameters
PILOT_SPEED_UP      50          # SURFTRAK uses PILOT_ parameters in cm
PILOT_SPEED_DN      50
PILOT_ACCEL_Z       500
WP_SPD_UP           0.5         # GUIDED uses WP_ parameters in m
WP_SPD_DN           0.5
WP_ACC_Z            5.0
PSC_D_JERK          8.0         # Both modes use PSC_ parameters in m
